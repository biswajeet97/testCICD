pipeline {
    agent any

    stages {

        stage('Compile') {
            steps {
                dir('cicd') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('cicd') {
                    sh './mvnw test'
                }
            }
        }
        stage('Quality Gate') {
            steps {
                dir('cicd') {
                    sh './mvnw verify -DskipTests'
                  }
              }
          }
        stage('SonarQube Analysis') {
        steps {
              dir('cicd') {
              withSonarQubeEnv('SonarQube') {
              sh './mvnw org.sonarsource.scanner.maven:sonar-maven-plugin:5.7.0.6970:sonar'
              }
            }
          }
        }
        stage('SonarQube Quality Gate') {
        steps {
            timeout(time: 10, unit: 'MINUTES') {
              waitForQualityGate abortPipeline: true
            }
          }
        }

        stage('SonarQube Quality Gate') {
          steps {
            timeout(time: 10, unit: 'MINUTES') {
              waitForQualityGate abortPipeline: true
            }
          }
        }
        stage('Package') {
            when {
              anyOf {
                branch 'dev'
                branch 'main'
              }
            }
            steps {
                dir('cicd') {
                    sh './mvnw package -DskipTests'
                }
            }
        }
    }

    post {
        always {
            junit testResults: 'cicd/target/surefire-reports/*.xml',
                  allowEmptyResults: true
            archiveArtifacts artifacts: 'cicd/target/site/jacoco/**',
                  allowEmptyArchive: true
        }

        success {
            echo 'BUILD SUCCESSFUL'
        }

        failure {
            echo 'BUILD FAILED'
        }
    }
}
